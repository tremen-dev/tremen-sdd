* text=auto
*.mjs text eol=lf
*.md text eol=lf
*.json text eol=lf
# Superficie de adaptadores no-Claude (Kimi): YAML de agentes y fragmento de
# hooks. LF estable para que el build sea determinista igual en Windows y en el
# CI de Ubuntu (el artefacto se copia verbatim; una deriva CRLF cambiaría el árbol).
*.yaml text eol=lf
*.toml text eol=lf
# El shim del pre-commit lo ejecuta `sh`: debe conservar LF aunque se clone en
# Windows con autocrlf, o `sh` fallaría al leer el shebang (#!/bin/sh\r).
tools/githooks/pre-commit text eol=lf
