{
  "name": "tremen-sdd",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build-adapter.mjs claude-code",
    "hooks:install": "node tools/install-hooks.mjs",
    "check": "node tools/check.mjs",
    "test:core": "node --test \"core/tests/*.test.mjs\"",
    "test:tools": "npm run build && node --test \"tools/tests/*.test.mjs\"",
    "test:adapter": "npm run build && node --test \"adapters/claude-code/tests/*.test.mjs\"",
    "test": "npm run build && node --test \"core/tests/*.test.mjs\" \"tools/tests/*.test.mjs\" \"adapters/claude-code/tests/*.test.mjs\""
  }
}
